# Variables de entorno para Resmoke

# Google Analytics 4 Configuration
# Obtén tu Measurement ID desde: https://analytics.google.com/
# 1. Ve a Google Analytics
# 2. Crea una cuenta de Analytics o inicia sesión
# 3. Crea una nueva propiedad GA4
# 4. Obtén tu Measurement ID (formato: G-XXXXXXXXXX)
# 5. Configura los dominios autorizados
VITE_GA_MEASUREMENT_ID=G-76E5NZ10M1

# Google OAuth Configuration
# Obtén tu Client ID desde: https://console.cloud.google.com/apis/credentials
# 1. Ve a Google Cloud Console
# 2. Crea un nuevo proyecto o selecciona uno existente
# 3. Habilita la API de Google+ 
# 4. Ve a "Credenciales" y crea un "ID de cliente OAuth 2.0"
# 5. Configura los orígenes autorizados: http://localhost:5173 (para desarrollo)
# 6. Configura las URI de redirección autorizadas: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=tu_google_client_id_aqui.apps.googleusercontent.com

# Google AdSense Configuration
# Obtén tu Publisher ID desde: https://www.google.com/adsense/
# 1. Ve a Google AdSense
# 2. Crea una cuenta de AdSense o inicia sesión
# 3. Agrega tu sitio web
# 4. Obtén tu código de publisher (ca-pub-xxxxxxxxxxxxxxxxx)
# 5. Configura las unidades de anuncios
VITE_GOOGLE_ADSENSE_PUBLISHER_ID=ca-pub-6662622783065413
VITE_GOOGLE_ADSENSE_ENABLED=true

# AdSense Ad Slots (IDs de las unidades de anuncios)
# Crea las unidades en AdSense y coloca aquí sus IDs
VITE_ADSENSE_SLOT_BANNER=0000000000
VITE_ADSENSE_SLOT_RECTANGLE=0000000000
VITE_ADSENSE_SLOT_SIDEBAR=0000000000
VITE_ADSENSE_SLOT_MOBILE=0000000000

# Stripe Configuration
# Obtén tus claves desde: https://dashboard.stripe.com/apikeys
# 1. Ve a Stripe Dashboard
# 2. Crea una cuenta de Stripe o inicia sesión
# 3. Ve a "Developers" > "API keys"
# 4. Copia la "Publishable key" (pk_test_... para testing, pk_live_... para producción)
# 5. Copia la "Secret key" (sk_test_... para testing, sk_live_... para producción)
# 6. Configura los webhooks en "Developers" > "Webhooks"
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_tu_clave_publica_aqui
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta_aqui
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret_aqui

